import React, { useState } from "react";

function App() {
  const products = [
    { id: 1, name: "HP Laptop", category: "Laptops", price: 55000, icon: "💻" },
    { id: 2, name: "Dell Desktop", category: "Computers", price: 45000, icon: "🖥️" },
    { id: 3, name: "Gaming Keyboard", category: "Accessories", price: 2500, icon: "⌨️" },
    { id: 4, name: "Wireless Mouse", category: "Accessories", price: 800, icon: "🖱️" },
    { id: 5, name: "Samsung Monitor", category: "Monitors", price: 12000, icon: "🖥️" },
    { id: 6, name: "Gaming Laptop", category: "Laptops", price: 75000, icon: "🎮" },
    { id: 7, name: "Headphones", category: "Accessories", price: 1500, icon: "🎧" },
    { id: 8, name: "Printer", category: "Computers", price: 8500, icon: "🖨️" }
  ];

  const [cart, setCart] = useState([]);
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");

  function addToCart(product) {
    setCart([...cart, product]);
  }

  function removeFromCart(index) {
    setCart(cart.filter((item, i) => i !== index));
  }

  const filteredProducts = products.filter((product) => {
    return (
      product.name.toLowerCase().includes(search.toLowerCase()) &&
      (category === "All" || product.category === category)
    );
  });

  const total = cart.reduce((sum, item) => sum + item.price, 0);

  return (
    <div>
      <style>{`
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        html {
          scroll-behavior: smooth;
        }

        body {
          font-family: Arial, sans-serif;
          background: #f4f6f9;
          color: #222;
        }

        header {
          background: #101d35;
          color: white;
          padding: 20px 7%;
          display: flex;
          justify-content: space-between;
          align-items: center;
          flex-wrap: wrap;
          gap: 15px;
        }

        header h1 {
          color: #00c6ff;
        }

        nav {
          display: flex;
          gap: 25px;
        }

        nav a {
          color: white;
          text-decoration: none;
          font-weight: bold;
        }

        nav a:hover {
          color: #00c6ff;
        }

        .hero {
          background: linear-gradient(120deg, #101d35, #176b87);
          color: white;
          text-align: center;
          padding: 100px 20px;
        }

        .hero h2 {
          font-size: 40px;
          margin-bottom: 15px;
        }

        .hero p {
          font-size: 19px;
          margin-bottom: 30px;
        }

        .shop-btn {
          background: #00c6ff;
          color: #101d35;
          padding: 13px 28px;
          border-radius: 5px;
          text-decoration: none;
          font-weight: bold;
        }

        .products-section, .cart-section {
          padding: 50px 7%;
          text-align: center;
        }

        .products-section h2, .cart-section h2 {
          margin-bottom: 25px;
          font-size: 30px;
        }

        input, select {
          padding: 12px;
          margin: 8px;
          border: 1px solid #bbb;
          border-radius: 5px;
          font-size: 15px;
        }

        .product-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
          gap: 25px;
          margin-top: 30px;
        }

        .product-card {
          background: white;
          padding: 25px 15px;
          border-radius: 10px;
          box-shadow: 0 3px 12px #00000015;
          transition: 0.3s;
        }

        .product-card:hover {
          transform: translateY(-6px);
        }

        .product-icon {
          font-size: 65px;
          margin-bottom: 15px;
        }

        .product-card h3 {
          margin: 12px 0;
        }

        .product-card p {
          color: #666;
        }

        button {
          background: #0879c9;
          color: white;
          padding: 11px 18px;
          border: none;
          border-radius: 5px;
          cursor: pointer;
          margin-top: 12px;
        }

        button:hover {
          background: #00518a;
        }

        .cart-section {
          background: white;
        }

        .cart-item {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 10px;
          max-width: 600px;
          margin: 12px auto;
          padding: 12px;
          background: #f1f4f8;
          border-radius: 5px;
        }

        .cart-section h3 {
          margin-top: 25px;
        }

        footer {
          background: #101d35;
          color: white;
          text-align: center;
          padding: 25px;
          line-height: 2;
        }

        @media (max-width: 600px) {
          header {
            flex-direction: column;
          }

          .hero h2 {
            font-size: 30px;
          }

          nav {
            gap: 15px;
          }

          .cart-item {
            flex-wrap: wrap;
          }
        }
      `}</style>

      <header>
        <h1>💻 TechZone</h1>
        <nav>
          <a href="#home">Home</a>
          <a href="#products">Products</a>
          <a href="#cart">Cart ({cart.length})</a>
        </nav>
      </header>

      <section className="hero" id="home">
        <h2>Welcome to TechZone</h2>
        <p>Your One-Stop Computer Shopping Store</p>
        <a href="#products" className="shop-btn">Shop Now</a>
      </section>

      <section className="products-section" id="products">
        <h2>Our Products</h2>

        <input
          type="text"
          placeholder="Search products..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />

        <select
          value={category}
          onChange={(e) => setCategory(e.target.value)}
        >
          <option value="All">All Categories</option>
          <option value="Laptops">Laptops</option>
          <option value="Computers">Computers</option>
          <option value="Monitors">Monitors</option>
          <option value="Accessories">Accessories</option>
        </select>

        <div className="product-grid">
          {filteredProducts.map((product) => (
            <div className="product-card" key={product.id}>
              <div className="product-icon">{product.icon}</div>
              <h3>{product.name}</h3>
              <p>Category: {product.category}</p>
              <h3>₹{product.price.toLocaleString("en-IN")}</h3>
              <button onClick={() => addToCart(product)}>
                Add to Cart
              </button>
            </div>
          ))}
        </div>

        {filteredProducts.length === 0 && <p>No products found.</p>}
      </section>

      <section className="cart-section" id="cart">
        <h2>🛒 Shopping Cart</h2>

        {cart.length === 0 ? (
          <p>Your cart is empty.</p>
        ) : (
          cart.map((item, index) => (
            <div className="cart-item" key={index}>
              <span>
                {item.name} - ₹{item.price.toLocaleString("en-IN")}
              </span>
              <button onClick={() => removeFromCart(index)}>
                Remove
              </button>
            </div>
          ))
        )}

        <h3>Total Amount: ₹{total.toLocaleString("en-IN")}</h3>
      </section>

      <footer>
        <p>© 2026 TechZone | All Rights Reserved</p>
        <p>Computer Shopping Website Using React JS</p>
      </footer>
    </div>
  );
}

export default App;